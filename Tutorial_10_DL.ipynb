#FINAL INFERENCE /PREDICTION CELL WITH CLASS LABEL & CONFIDENCE
 
import glob, os, cv2
import numpy as np
import matplotlib.pyplot as plt
import torch

CLASS_NAME = "Polar Bear"
best_model = lr_results[1e-3]["model"]
best_model.eval()

def predict_and_label_image(image_path, model, img_size=128, threshold=0.5):
    orig_bgr = cv2.imread(image_path)
    orig_rgb = cv2.cvtColor(orig_bgr, cv2.COLOR_BGR2RGB)
    h_orig, w_orig, _ = orig_rgb.shape

    resized = cv2.resize(orig_rgb, (img_size, img_size)) / 255.0
    input_tensor = torch.tensor(np.transpose(resized, (2, 0, 1)), dtype=torch.float32).unsqueeze(0).to(device)

    with torch.no_grad():
        prob_map = model(input_tensor)[0, 0].cpu().numpy()

    prob_full = cv2.resize(prob_map, (w_orig, h_orig))
    binary_mask = (prob_full > threshold).astype(np.uint8)

    foreground_pixels = np.sum(binary_mask)
    coverage_pct = (foreground_pixels / (h_orig * w_orig)) * 100.0

    overlay = orig_rgb.copy()
    if foreground_pixels > 50:
        confidence = float(prob_full[binary_mask == 1].mean()) * 100.0
        verdict = f"DETECTED: {CLASS_NAME} ({confidence:.1f}% confidence | {coverage_pct:.1f}% of image)"

        color_mask = np.zeros_like(overlay)
        color_mask[binary_mask == 1] = [0, 255, 255]
        overlay = cv2.addWeighted(overlay, 0.7, color_mask, 0.3, 0)

        ys, xs = np.where(binary_mask == 1)
        x1, y1, x2, y2 = xs.min(), ys.min(), xs.max(), ys.max()
        cv2.rectangle(overlay, (x1, y1), (x2, y2), (0, 255, 255), 2)
        cv2.putText(overlay, f"{CLASS_NAME}: {confidence:.1f}%", (x1, max(20, y1 - 8)),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
    else:
        verdict = f"NOT DETECTED: No {CLASS_NAME} found (only Background)"

    fig, axes = plt.subplots(1, 3, figsize=(15, 5))
    axes[0].imshow(orig_rgb); axes[0].set_title("1. Unseen Input Image"); axes[0].axis("off")
    axes[1].imshow(binary_mask, cmap="gray"); axes[1].set_title(f"2. Predicted Mask (1={CLASS_NAME}, 0=Bg)"); axes[1].axis("off")
    axes[2].imshow(overlay); axes[2].set_title(f"3. Labeled Overlay ({CLASS_NAME})"); axes[2].axis("off")
    plt.suptitle(verdict, fontsize=13, fontweight="bold", color="navy")
    plt.tight_layout()
    plt.show()

